STAGE=prod
AWS_PROFILE=personal-stg
AWS_REGION=us-east-1
ROOT_DOMAIN=brimax.life
CONTACT_EMAIL=casamento@brimax.life
API_DOMAIN=api.brimax.life
WWW_DOMAIN=www.brimax.life
VITE_CONTACT_EMAIL=
# Optional. Leave empty and let the scripts auto-discover it during bootstrap.
LANDING_CERTIFICATE_ARN=
CLOUDFLARE_API_TOKEN=replace-me
CLOUDFLARE_ZONE_ID=replace-me
TOFU_STATE_KEY_PREFIX=brimax-life
PAYMENTS_STACK_NAME=BrimaxAppStack
PAYMENTS_DATA_STACK_NAME=BrimaxDataStack
PAYMENTS_OBSERVABILITY_STACK_NAME=BrimaxObservabilityStack
OBSERVABILITY_ALERT_EMAIL=
XRAY_ENABLED=true
ASAAS_ENV=production
ASAAS_API_BASE_URL=https://api.asaas.com/v3
# Raw secret source values used by CDK to create:
# /prod/brimax/asaas/api-key
# /prod/brimax/asaas/webhook-token
# /prod/brimax/turnstile/secret-key
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Cloudflare Turnstile Secret Key (server-side, private).
# Required for prod deploys; if unset for dev, CDK falls back to Cloudflare's
# always-passes test secret (1x0000000000000000000000000000000AA).
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=0x4AAAAAADWSl1ce7VLNgFRo
PAYMENTS_TEST_GIFT_ID=g-test-pix
PAYMENTS_TEST_GIFT_QUANTITY=1
PAYMENTS_TEST_PAYER_NAME=
PAYMENTS_TEST_PAYER_EMAIL=
PAYMENTS_TEST_PAYER_CPF=
PAYMENTS_TEST_PAYER_PHONE=
VITE_API_URL=
VITE_TURNSTILE_SITE_KEY=

# Sentry bootstrap token used by the OpenTofu Sentry provider.
SENTRY_AUTH_TOKEN=
SENTRY_TEAM_SLUG=brimax-life
# Optional override. The backend deploy script resolves this from the
# infra/opentofu/sentry outputs after the module is applied.
SENTRY_DSN=
SENTRY_ORG=brimax
