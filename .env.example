STAGE=prod
AWS_PROFILE=personal-stg
AWS_REGION=us-east-1
ROOT_DOMAIN=brimax.life
API_DOMAIN=api.brimax.life
# Optional. Leave empty and let the scripts auto-discover it during bootstrap.
LANDING_CERTIFICATE_ARN=
CLOUDFLARE_API_TOKEN=replace-me
CLOUDFLARE_ZONE_ID=replace-me
TOFU_STATE_KEY_PREFIX=brimax-life
PAYMENTS_STACK_NAME=BrimaxAppStack
PAYMENTS_DATA_STACK_NAME=BrimaxDataStack
PAYMENTS_OBSERVABILITY_STACK_NAME=BrimaxObservabilityStack
ASAAS_ENV=production
ASAAS_API_BASE_URL=https://api.asaas.com/v3
# Raw secret source values used by CDK to create:
# /prod/brimax/asaas/api-key
# /prod/brimax/asaas/webhook-token
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
PAYMENTS_TEST_GIFT_ID=g-test-pix
PAYMENTS_TEST_GIFT_QUANTITY=1
PAYMENTS_TEST_PAYER_NAME=
PAYMENTS_TEST_PAYER_EMAIL=
PAYMENTS_TEST_PAYER_CPF=
PAYMENTS_TEST_PAYER_PHONE=
