# Reference only: supported commands load public web env from the repo-root
# `.env` / `.env.dev` files through `scripts/landing-env.sh`.
VITE_API_URL=https://api.brimax.life
VITE_CONTACT_EMAIL=casamento@brimax.life
# Cloudflare Turnstile site key (public). Use the always-passes test key
# 1x00000000000000000000AA for local development.
VITE_TURNSTILE_SITE_KEY=

# Local dev only: origin that serves /media/* (the deployed CDN). The Vite dev
# server proxies /media -> here so images/video resolve without CloudFront in
# front of localhost. Defaults to https://dev.brimax.life (derives from
# ROOT_DOMAIN when running via pnpm dev:web / pnpm dev:all-web). Not
# VITE_-prefixed and ignored by builds,
# so it has no effect on production. Override to point dev at another CDN/mock.
# MEDIA_PROXY_TARGET=https://dev.brimax.life

# Local dev only: origin of the HTTP API that the dev server read-only proxies
# /api/* to (GET/HEAD; writes are blocked locally). Lets guest messages load
# without the prod CORS allowlist. Defaults to https://api.dev.brimax.life
# (derives from API_DOMAIN via pnpm dev:web / pnpm dev:all-web). Not
# VITE_-prefixed and ignored by
# builds, so production is unaffected.
# API_PROXY_TARGET=https://api.dev.brimax.life
