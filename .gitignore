.terraform.tfstate.lock.info
.opentofu/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# === Environments / secrets ===
.env
.env.*
!.env.example
.envrc

# === Editor / IDE ===
.vscode/
.idea/

