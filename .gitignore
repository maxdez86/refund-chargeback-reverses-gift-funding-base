# === Node / TypeScript ===
node_modules/
dist/
build/
coverage/
.turbo/
.pnpm-store/
.vite/
.cache/
*.tsbuildinfo

# === Vite temp config (rewritten on every dev start) ===
vite.config.ts.timestamp-*
vite.config.js.timestamp-*

# === Dev / debug logs ===
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
.tmp/

# === AWS CDK ===
cdk.out/
cdk.out.*/
# cdk.context.json is intentionally committed (AWS recommendation — caches account/AZ lookups for reproducible synth)

# === OpenTofu / Terraform ===
# .terraform.lock.hcl IS committed (already tracked under infra/opentofu/*/)
.terraform/
.terraform.tfstate.lock.info
.opentofu/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# === Environments / secrets ===
.env
.env.*
!.env.example
.envrc

# === Editor / IDE ===
.vscode/
.idea/

# === OS noise ===
.DS_Store
Thumbs.db
*.swp
*.swo

# === One-off vendor exports (data lives in IaC) ===
DNS_Configuration.csv

# === Secrets / keys (defense in depth) ===
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# === AI tool artifacts ===
.codex
.aider*
.cursor/
.continue/
.windsurf/

# === Lint / format caches ===
